IcespireTown_House3_MapScripts::
	.byte 0

IcespireTown_House3_EventScript_VeilLieutenant::
	lock
	faceplayer
	msgbox IcespireTown_House3_Text_VeilLieutenant, MSGBOX_DEFAULT
	release
	end

IcespireTown_House3_Text_VeilLieutenant:
	.string "MAN IN BLACK: You weren't\n"
	.string "invited in.\p"
	.string "...\p"
	.string "Relax, kid. I'm not going to\n"
	.string "bite you. I just don't like\l"
	.string "surprises.\p"
	.string "Yes, I'm with the DIRECTOR'S\n"
	.string "people. No, I'm not a GRUNT.\l"
	.string "I don't wear the uniform.\l"
	.string "I don't want to.\p"
	.string "I do logistics. Supply routes.\n"
	.string "The cold moves differently\l"
	.string "than the warm. You have to plan.\p"
	.string "If SILVAN gave you the badge,\n"
	.string "you earned it. I won't pretend\l"
	.string "otherwise.\p"
	.string "Listen. Friendly advice. Don't\n"
	.string "ask questions in this town.\p"
	.string "People here want to be happy.\n"
	.string "They don't want to know why.\p"
	.string "Good trainers know when to\n"
	.string "walk out of a room.$"
